# AI Provider Selection: 'openai' (default cloud), 'ollama' (free local), or 'puter' (Puter AI platform)
AI_PROVIDER=openai

# OpenAI Cloud Configuration (used when AI_PROVIDER=openai)
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o-mini

# Ollama Free Local Configuration (used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Puter AI Configuration (used when AI_PROVIDER=puter)
PUTER_AUTH_TOKEN=
PUTER_MODEL=gpt-4o-mini

# Server Port & Protocol
PORT=3000

# Optional HTTPS Configuration
# To run local HTTPS: npm run generate-cert, then set USE_HTTPS=true
USE_HTTPS=false
SSL_KEY_PATH=./certs/key.pem
SSL_CERT_PATH=./certs/cert.pem
# Optional: Run dual HTTP (PORT) and HTTPS (HTTPS_PORT) simultaneously
# HTTPS_PORT=3443

